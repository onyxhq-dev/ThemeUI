        echo "<script>
document.addEventListener('DOMContentLoaded',function(){
  var s=getComputedStyle(document.documentElement);
  var c0=s.getPropertyValue('--brand-orange').trim();
  var c1=s.getPropertyValue('--usage-bar-background-color').trim();
  var acc=s.getPropertyValue('--usage-bar-used-background-color').trim();
  var dim=s.getPropertyValue('--alt-text-color').trim();
  var grid=s.getPropertyValue('--border-color').trim();
  var text=s.getPropertyValue('--text-color').trim();
  var red=s.getPropertyValue('--brand-red').trim();
  var mild=s.getPropertyValue('--mild-background-color').trim();
  var bg=s.getPropertyValue('--background-color').trim();
  if(typeof cpuchart!=='undefined'){
    cpuchart.options.grid.strokeStyle=grid;
    cpuchart.options.labels.fillStyle=text;
    if(cpuchart.seriesSet&&cpuchart.seriesSet[0])cpuchart.seriesSet[0].options.strokeStyle=c0;
  }
  if(typeof netchart!=='undefined'){
    netchart.options.grid.strokeStyle=grid;
    netchart.options.labels.fillStyle=text;
    if(netchart.seriesSet){
      if(netchart.seriesSet[0])netchart.seriesSet[0].options.strokeStyle=red;
      if(netchart.seriesSet[1])netchart.seriesSet[1].options.strokeStyle=c0;
    }
  }
  if(Array.isArray(window.colors)&&window.colors.length>=2){
    window.colors[0]=acc;window.colors[1]=c1;
  }
  function fixGrad(v){
    var seen={},order=[];
    var m,re=/#[0-9a-fA-F]{6}/gi;
    while((m=re.exec(v))!==null){var h=m[0].toLowerCase();if(!seen[h]){seen[h]=true;order.push(h);}}
    if(order.length<2)return v;
    var palette=[acc,c0,red];
    var result=v;
    result=result.replace(new RegExp(order[order.length-1],'gi'),c1);
    order.slice(0,-1).forEach(function(h,i){
      result=result.replace(new RegExp(h,'gi'),palette[i%palette.length]);
    });
    return result;
  }
  var jq=window.jQuery||window.$;
  if(jq&&jq.fn&&jq.fn.css){
    var oc=jq.fn.css,ps={sys0:1,sys1:1,sys2:1,sys3:1};
    jq.fn.css=function(p){
      if(p&&typeof p==='object'&&typeof p.background==='string'
         &&p.background.indexOf('conic-gradient')!==-1){
        for(var i=0;i<this.length;i++){
          if(ps[this[i].id]){
            var np={};for(var k in p)np[k]=p[k];
            np.background=fixGrad(p.background);
            return oc.call(this,np);
          }
        }
      }
      return oc.apply(this,arguments);
    };
  }
  var btnBg=s.getPropertyValue('--hover-button-background').trim();
  var btnFg=s.getPropertyValue('--hover-button-text-color').trim();
  var btnSel='input[type=\"button\"],input[type=\"reset\"],input[type=\"submit\"],button,a.button';
  function applyBtn(el){
    el.style.setProperty('background',btnBg,'important');
    el.style.setProperty('color',btnFg,'important');
    el.style.setProperty('border','none','important');
    el.addEventListener('mouseenter',function(){this.style.setProperty('opacity','0.8','important');});
    el.addEventListener('mouseleave',function(){this.style.removeProperty('opacity');});
  }
  document.querySelectorAll(btnSel).forEach(applyBtn);
  function themeIframe(doc){
    try{
      if(!doc||!doc.head||doc.getElementById('themeui-iframe-fix'))return;
      var st=doc.createElement('style');
      st.id='themeui-iframe-fix';
      st.textContent='body{background:'+bg+' !important}.logLine{color:'+text+' !important}fieldset.CMD{background:'+mild+' !important;border-color:'+grid+' !important;color:'+text+' !important}fieldset.CMD legend{color:'+text+' !important}span.id{color:'+c0+' !important}';
      doc.head.appendChild(st);
    }catch(e){}
  }
  function watchFrame(ifr){
    if(!ifr||ifr.getAttribute('data-themeui'))return;
    ifr.setAttribute('data-themeui','1');
    ifr.addEventListener('load',function(){themeIframe(ifr.contentDocument);});
    themeIframe(ifr.contentDocument);
  }
  document.querySelectorAll('iframe').forEach(watchFrame);
  new MutationObserver(function(muts){
    muts.forEach(function(m){
      m.addedNodes.forEach(function(n){
        if(n.nodeType!==1)return;
        if(n.matches&&n.matches(btnSel))applyBtn(n);
        if(n.querySelectorAll)n.querySelectorAll(btnSel).forEach(applyBtn);
        if(n.tagName==='IFRAME')watchFrame(n);
        if(n.querySelectorAll)n.querySelectorAll('iframe').forEach(watchFrame);
      });
    });
  }).observe(document.body,{childList:true,subtree:true});
});
</script>\n";
