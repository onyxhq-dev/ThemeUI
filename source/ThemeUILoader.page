      if(!svg.dataset.themeuiSwapped&&svg.querySelector('[id*=\"unraid-header-logo-gradient\"]'))swap(svg);
    });
  }
  scan();
  new MutationObserver(scan).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>\n";
    }
}
