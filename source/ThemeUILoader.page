(function(){
  var src = $logo_src_json;
  function swap(svg){
    if(!svg||svg.dataset.themeuiSwapped)return;
    svg.dataset.themeuiSwapped='1';
    var img=document.createElement('img');
    img.src=src;
    img.alt='Logo';
    img.style.cssText='$size_css width:auto;object-fit:contain;flex-shrink:0;';
    svg.replaceWith(img);
